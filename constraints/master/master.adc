# M1ABC master/controller - HX4S20C EG4S20BG256
# Proven board-link physical mapping from the supplied schematic:
#   FPGA J13 -> GPIOA10 -> J1 pin 8  : local TX
#   FPGA F13 -> GPIOA7  -> J1 pin 4  : local RX
#   J1 pin 12                        : GND (wire only, no FPGA constraint)
# Wiring: Master J1-8 -> Slave J1-4; Slave J1-8 -> Master J1-4; GND <-> GND.
set_pin_assignment { clk }          { LOCATION = R7;  IOSTANDARD = LVCMOS33; }
set_pin_assignment { rst_n }        { LOCATION = A2;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { uart_tx }      { LOCATION = J13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { uart_rx }      { LOCATION = F13; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# Board keys: KEY2 next, KEY3 previous, KEY4 play/pause. Active low.
set_pin_assignment { key_next_n }   { LOCATION = B2;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key_prev_n }   { LOCATION = B1;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key_play_n }   { LOCATION = C1;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# Four independent green LEDs, active high.
set_pin_assignment { led[0] }       { LOCATION = A4;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; }
set_pin_assignment { led[1] }       { LOCATION = A3;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; }
set_pin_assignment { led[2] }       { LOCATION = E13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; }
set_pin_assignment { led[3] }       { LOCATION = B12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; }

# Master now owns the board-proven HDMI_B output.
set_pin_assignment { HDMI_D0_P }    { LOCATION = G5; IOSTANDARD = LVDS33; }
set_pin_assignment { HDMI_D1_P }    { LOCATION = F1; IOSTANDARD = LVDS33; }
set_pin_assignment { HDMI_D2_P }    { LOCATION = E1; IOSTANDARD = LVDS33; }
set_pin_assignment { HDMI_CLK_P }   { LOCATION = C3; IOSTANDARD = LVDS33; }
set_pin_assignment { HDMI_DDC_SCL } { LOCATION = P2; IOSTANDARD = LVCMOS33; }
set_pin_assignment { HDMI_DDC_SDA } { LOCATION = R2; IOSTANDARD = LVCMOS33; }
set_pin_assignment { link_data[0] } { LOCATION = D14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_data[1] } { LOCATION = G11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_data[2] } { LOCATION = G12; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_data[3] } { LOCATION = H13; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_data[4] } { LOCATION = H14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_data[5] } { LOCATION = J14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_data[6] } { LOCATION = K12; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_req } { LOCATION = L14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_ack } { LOCATION = M14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLDOWN; }
set_pin_assignment { display_published } { LOCATION = L16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLDOWN; }

# Eight-bit LED diagnostic group / nixie shared pins.  Active-low cathodes.
# Put board SW6 in the LED position to view these diagnostics.
set_pin_assignment { diag_led_n[0] } { LOCATION = C15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { diag_led_n[1] } { LOCATION = C16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { diag_led_n[2] } { LOCATION = B6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { diag_led_n[3] } { LOCATION = A5;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { diag_led_n[4] } { LOCATION = B5;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { diag_led_n[5] } { LOCATION = A8;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { diag_led_n[6] } { LOCATION = A7;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { diag_led_n[7] } { LOCATION = A6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { diag_sel_n[0] } { LOCATION = F16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { diag_sel_n[1] } { LOCATION = E16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { diag_sel_n[2] } { LOCATION = E12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { diag_sel_n[3] } { LOCATION = E10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { diag_sel_n[4] } { LOCATION = C13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { diag_sel_n[5] } { LOCATION = F10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { diag_sel_n[6] } { LOCATION = E11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { diag_sel_n[7] } { LOCATION = D11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
